# fleetmind .env.example
#
# fleetmind reads secrets from a local encrypted store (`fleetmind secrets ...`)
# OR from environment variables. fleet.yaml uses `${VAR_NAME}` substitution to
# pick them up at deploy time.
#
# This file lists the env vars fleetmind itself reads, plus the conventional
# names for Slack tokens. Per-fleet secret names are arbitrary — match whatever
# you reference in fleet.yaml.

# ── AWS ───────────────────────────────────────────────────────────────────────
# Region for DynamoDB / S3 calls (ContextStore + delegation task ledger).
# fleet.yaml's `context.region` and `delegation.aws_region` override per-feature.
# fleetmind throws if neither this nor AWS_DEFAULT_REGION is set when AWS calls
# are needed.
AWS_REGION=us-west-2
# AWS_DEFAULT_REGION=us-west-2  # accepted as fallback

# ── Continuous Agentics private skill registry (optional) ─────────────────────
# Required only if any agent uses `source: private` skills.
# Run: fleetmind secrets set CA_REGISTRY_TOKEN <token>
# CA_REGISTRY_TOKEN=

# ── Slack — one bot/app token pair per agent ──────────────────────────────────
# Naming convention: <AGENT_ID_UPPER>_BOT_TOKEN, <AGENT_ID_UPPER>_APP_TOKEN
# Match these to the ${...} references in fleet.yaml's agents[*].slack block.
# CONDUCTOR_BOT_TOKEN=xoxb-...
# CONDUCTOR_APP_TOKEN=xapp-...
# PIXEL_BOT_TOKEN=xoxb-...
# PIXEL_APP_TOKEN=xapp-...
# FORGE_BOT_TOKEN=xoxb-...
# FORGE_APP_TOKEN=xapp-...

# ── LLM providers (passed through to OpenClaw) ────────────────────────────────
# OpenClaw reads these at gateway startup; fleetmind doesn't read them itself,
# but they're conventionally listed here for fleet operators to set together.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Local development ─────────────────────────────────────────────────────────
# For in-memory ContextStore (no DynamoDB), set `context.provider: local`
# in fleet.yaml — there's no env-var override.
